[Unit]
Description=Junior Realtime Helper display and DSM readiness monitor
After=local-fs.target network.target

[Service]
Type=simple
User=root
ExecStart=/bin/sh /usr/syno/sbin/junior-realtime-helper/dsm-start.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group

[Install]
WantedBy=multi-user.target
